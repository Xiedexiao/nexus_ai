# Gateway-only image for the split deployment (api + web + postgres + redis).
#
# The Go module embeds web/dist at compile time, so this build compiles a
# placeholder page instead of the console; docker/Dockerfile.web serves the real
# console. Use docker/Dockerfile for the single-binary deployment.
ARG GO_IMAGE=golang:1.26.10-alpine
ARG RUNTIME_IMAGE=debian:bookworm-slim
# Build-time network settings. Override them where proxy.golang.org or
# deb.debian.org is unreachable, e.g.
#   docker compose build --build-arg GOPROXY=https://goproxy.cn,direct
ARG GOPROXY=https://proxy.golang.org,direct
# Set to a mirror host to rewrite deb.debian.org during apt-get.
ARG DEBIAN_MIRROR=

FROM ${GO_IMAGE} AS builder

ENV GO111MODULE=on CGO_ENABLED=0
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc
ARG GOPROXY
ENV GOPROXY=${GOPROXY}

WORKDIR /build/backend

ADD backend/go.mod backend/go.sum ./
# relaykit and tokenkit are local submodules referenced via replace; their
# go.mod files must be present for go mod download to resolve the main module graph.
ADD backend/relaykit/go.mod ./relaykit/go.mod
ADD backend/tokenkit/go.mod ./tokenkit/go.mod
RUN go mod download

COPY . /build

RUN mkdir -p web/dist && \
    echo '<!doctype html><html><head><title>api</title></head><body>console served by the web service</body></html>' > web/dist/index.html

RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat /build/VERSION)'" -o new-api

FROM ${RUNTIME_IMAGE}

ARG DEBIAN_MIRROR
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
      sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder /build/backend/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
